;; ── Hello World Widget ──────────────────────────────────────
(defwindow hello-world
  :monitor 0
  :geometry (geometry :x "-12px"
                     :y "50px"
                     :width "220px"
                     :anchor "top right")
  :stacking "overlay"
  :focusable "none"
  (box :class "hello-widget"
       :orientation "vertical"
       :halign "fill"
       :space-evenly false
    ;; Header row
    (box :class "hello-header"
         :orientation "horizontal"
         :halign "fill"
         :space-evenly false
      (label :text "" :class "hello-icon")
      (label :text "Hello Widget" :class "hello-title")
      (button :onclick "eww close hello-world"
              :class "hello-close"
        "×"))
    ;; Body
    (label :text "Eww is running!" :class "hello-body")
    ;; Footer / status
    (box :class "hello-footer"
         :orientation "horizontal"
         :halign "fill"
         :space-evenly false
      (label :text "● online" :class "hello-status")
      (label :text "v0.1" :class "hello-version"))))

;; ── Tailscale Widget ──────────────────────────────────────

;; ── Variables (one per display field) ──
(defvar ts_state_icon "")
(defvar ts_state_label "Stopped")
(defvar ts_tailnet "")
(defvar ts_self_name "")
(defvar ts_self_ip "")
(defvar ts_self_online "○")
(defvar ts_exit_node_name "None")
(defvar ts_exit_node_ip "")
(defvar ts_peers_online "0")
(defvar ts_peers_total "0")
(defvar ts_peers_exit_count "0")
(defvar ts_peers_text "")

;; ── Trigger: runs tailscale-eww-update every 10s ──
(defpoll ts_tick :interval "10s" "tailscale-eww-update")

(defwindow tailscale
  :monitor 0
  :geometry (geometry :x "-12px"
                     :y "50px"
                     :width "380px"
                     :anchor "top right")
  :stacking "overlay"
  :focusable "none"
  (box :class "ts-window"
       :orientation "vertical"
       :halign "fill"
       :space-evenly false
    ;; ── Header ──────────────────────────────
    (box :class "ts-header"
         :orientation "horizontal"
         :halign "fill"
         :space-evenly false
      (label :text "󱀶" :class "ts-header-icon")
      (label :text "Tailscale" :class "ts-header-title")
      (label :text ts_tailnet :class "ts-header-tailnet")
      (button :onclick "eww close tailscale"
              :class "ts-header-close"
        "×"))
    ;; ── Connection status bar ───────────────
    (box :class "ts-status"
         :orientation "horizontal"
         :halign "fill"
         :space-evenly false
      (label :text ts_state_icon :class "ts-status-icon")
      (label :text ts_state_label :class "ts-status-text")
      (label :text ts_self_ip :class "ts-status-ip"))
    ;; ── Your Node section ───────────────────
    (box :class "ts-section"
         :orientation "vertical"
         :halign "fill"
         :space-evenly false
      (label :text "Your Node" :class "ts-section-title")
      (box :orientation "horizontal"
           :halign "fill"
           :space-evenly false
        (label :text ts_self_name :class "ts-node-name")
        (label :text ts_self_ip :class "ts-node-ip")
        (label :text ts_self_online :class "ts-status-dot")))
    ;; ── Exit Node section ───────────────────
    (box :class "ts-section"
         :orientation "vertical"
         :halign "fill"
         :space-evenly false
      (label :text "Exit Node" :class "ts-section-title")
      (box :orientation "horizontal"
           :halign "fill"
           :space-evenly false
        (label :text ts_exit_node_name :class "ts-exit-name")
        (label :text ts_exit_node_ip :class "ts-exit-ip")
        (button :onclick "tailscale-eww-exitnode"
                :class "ts-exit-btn"
        "Change…")))
    ;; ── Quick actions ───────────────────────
    (box :class "ts-actions"
         :orientation "horizontal"
         :halign "fill"
         :space-evenly true
      (button :onclick "tailscale-eww-toggle"
              :class "ts-action-btn"
        "𖦹 Toggle Connect")
      (button :onclick "tailscale-eww-exitnode"
              :class "ts-action-btn"
        "󰮂 Exit Nodes")
      (button :onclick "eww poll ts_tick"
              :class "ts-action-btn"
        " Refresh"))
    ;; ── Peers list ──────────────────────────
    (box :class "ts-section"
         :orientation "vertical"
         :halign "fill"
         :space-evenly false
      (box :orientation "horizontal"
           :halign "fill"
           :space-evenly false
        (label :text "Peers (${ts_peers_online}/${ts_peers_total})" :class "ts-section-title")
        (label :text "${ts_peers_exit_count} exit nodes" :class "ts-section-subtitle"))
      (label :text ts_peers_text :class "ts-peers-text" :wrap true))))
;; ── Media Picker ──────────────────────────────────────────
;; Two polls instead of one combined object: `for` iterates a JSON array
;; held directly in a variable, so each list gets its own variable.
(defpoll mp_players :interval "2s" "media-picker-data players")
(defpoll mp_tabs :interval "2s" "media-picker-data tabs")

(defwindow media-picker
  :monitor 0
  :geometry (geometry
              :x "0px"
              :y "50px"
              :width "504px"
              :anchor "top center")
  :stacking "overlay"
  :focusable "none"
  ;; Mouse-out closes it; the window stays unfocusable so opening the
  ;; picker never takes keyboard focus from the focused application.
  (eventbox :onhoverlost "eww close media-picker"
    (box :class "mp-window"
         :orientation "vertical"
         :halign "fill"
         :space-evenly false
      ;; Header
      (box :class "mp-header"
           :orientation "horizontal"
           :halign "fill"
           :space-evenly false
        (label :text "󰎆" :class "mp-header-icon")
        (label :text "Media" :class "mp-header-title" :hexpand true)
        (button :onclick "eww close media-picker"
                :timeout "1s"
                :class "mp-header-close"
          (label :text "×")))
      ;; Players
      (box :class "mp-section"
           :orientation "vertical"
           :halign "fill"
           :space-evenly false
        (label :text "Players" :class "mp-section-title" :halign "start")
        (for p in mp_players
          (eventbox :class "mp-row"
                    :timeout "1s"
                    :cursor "pointer"
                    :onclick "media-picker-action toggle ${p.id}"
                    :onscroll "media-picker-action player-volume ${p.id} {}"
            (box :orientation "horizontal"
                 :halign "fill"
                 :space-evenly false
              (button :class "mp-row-toggle"
                      :timeout "1s"
                      :onclick "media-picker-action toggle ${p.id}"
                (label :text "${p.icon}"))
              (label :text "${p.name}" :class "mp-row-name")
              (label :text "${p.detail}"
                     :class "mp-row-detail"
                     :halign "start"
                     :hexpand true
                     :truncate true)
              (label :text "${p.volume}%" :class "mp-row-volume")
              (button :class "mp-row-pin"
                      :timeout "1s"
                      :onclick "media-picker-action pin ${p.id}"
                (label :text "${p.pin}"))))))
      ;; Browser tabs (one row per audio-producing tab)
      (box :class "mp-section"
           :orientation "vertical"
           :halign "fill"
           :space-evenly false
        (label :text "Tabs" :class "mp-section-title" :halign "start")
        (for t in mp_tabs
          (eventbox :class "mp-row"
                    :timeout "1s"
                    :cursor "pointer"
                    :onclick "media-picker-action tab-mute ${t.index}"
                    :onrightclick "media-picker-action tab-focus ${t.index}"
                    :onscroll "media-picker-action tab-volume ${t.index} {}"
            (box :orientation "horizontal"
                 :halign "fill"
                 :space-evenly false
              (button :class "mp-row-toggle"
                      :timeout "1s"
                      :onclick "media-picker-action tab-mute ${t.index}"
                (label :text "${t.icon}${t.state}"))
              (label :text "${t.title}"
                     :class "mp-row-detail"
                     :halign "start"
                     :hexpand true
                     :truncate true)
              (label :text "${t.volume}%" :class "mp-row-volume")
              (label :text "" :class "mp-row-pin")))))
      (label :text "scroll a row to set its volume" :class "mp-hint" :halign "start"))))
;; ── Autoclicker ───────────────────────────────────────────
;; The poll drives the marks: `autoclicker-eww-sync` reads the daemon over IPC and pushes
;; the active rows back with `eww update` (the same pattern as tailscale-eww-update).
(defpoll ac_tick :interval "1s" "autoclicker-eww-sync")

(defvar ac_mark_off "◎")
(defvar ac_mark_scroll_left "◎")
(defvar ac_mark_scroll_right "◎")
(defvar ac_mark_timer "◎")
(defvar ac_iv_100 "◎")
(defvar ac_iv_250 "◎")
(defvar ac_iv_500 "◎")
(defvar ac_iv_1000 "◎")
(defvar ac_btn_left "◎")
(defvar ac_btn_middle "◎")
(defvar ac_btn_right "◎")
(defvar ac_details "")

(defwindow autoclicker-menu
  :monitor 0
  :geometry (geometry
              :x "0px"
              :y "50px"
              :width "420px"
              :anchor "top center")
  :stacking "overlay"
  :focusable "none"
  ;; Mouse-out closes it, exactly like the media picker; staying unfocusable means opening
  ;; the menu never takes keyboard focus from the application being clicked.
  (eventbox :onhoverlost "eww close autoclicker-menu"
    (box :class "ac-window"
         :orientation "vertical"
         :halign "fill"
         :space-evenly false
      (box :class "ac-header"
           :orientation "horizontal"
           :halign "fill"
           :space-evenly false
        (label :text "󰍺" :class "ac-header-icon")
        (label :text "Autoclicker" :class "ac-header-title" :hexpand true)
        (button :onclick "eww close autoclicker-menu"
                :timeout "1s"
                :class "ac-header-close"
          (label :text "×")))
      (box :class "ac-section"
           :orientation "vertical"
           :halign "fill"
           :space-evenly false
        (label :text "Mode" :class "ac-section-title" :halign "start")
        (eventbox :class "ac-row" :timeout "1s" :cursor "pointer" :onclick "autoclicker mode off"
          (box :orientation "horizontal" :halign "fill" :space-evenly false
            (label :text ac_mark_off :class "ac-row-mark")
            (label :text "Off" :class "ac-row-name" :hexpand true :halign "start")))
        (eventbox :class "ac-row" :timeout "1s" :cursor "pointer" :onclick "autoclicker mode scroll-left"
          (box :orientation "horizontal" :halign "fill" :space-evenly false
            (label :text ac_mark_scroll_left :class "ac-row-mark")
            (label :text "Scroll -> left click" :class "ac-row-name" :hexpand true :halign "start")))
        (eventbox :class "ac-row" :timeout "1s" :cursor "pointer" :onclick "autoclicker mode scroll-right"
          (box :orientation "horizontal" :halign "fill" :space-evenly false
            (label :text ac_mark_scroll_right :class "ac-row-mark")
            (label :text "Scroll -> right click" :class "ac-row-name" :hexpand true :halign "start")))
        (eventbox :class "ac-row" :timeout "1s" :cursor "pointer" :onclick "autoclicker mode timer"
          (box :orientation "horizontal" :halign "fill" :space-evenly false
            (label :text ac_mark_timer :class "ac-row-mark")
            (label :text "Timer (auto-click)" :class "ac-row-name" :hexpand true :halign "start"))))
      (box :class "ac-section"
           :orientation "vertical"
           :halign "fill"
           :space-evenly false
        (label :text "Timer interval" :class "ac-section-title" :halign "start")
        (box :orientation "horizontal" :halign "fill" :space-evenly false
          (eventbox :class "ac-row" :timeout "1s" :cursor "pointer" :onclick "autoclicker set interval 100"
            (box :orientation "horizontal" :halign "fill" :space-evenly false
              (label :text ac_iv_100 :class "ac-row-mark")
              (label :text "100 ms" :class "ac-row-name" :hexpand true :halign "start")))
          (eventbox :class "ac-row" :timeout "1s" :cursor "pointer" :onclick "autoclicker set interval 250"
            (box :orientation "horizontal" :halign "fill" :space-evenly false
              (label :text ac_iv_250 :class "ac-row-mark")
              (label :text "250 ms" :class "ac-row-name" :hexpand true :halign "start")))
          (eventbox :class "ac-row" :timeout "1s" :cursor "pointer" :onclick "autoclicker set interval 500"
            (box :orientation "horizontal" :halign "fill" :space-evenly false
              (label :text ac_iv_500 :class "ac-row-mark")
              (label :text "500 ms" :class "ac-row-name" :hexpand true :halign "start")))
          (eventbox :class "ac-row" :timeout "1s" :cursor "pointer" :onclick "autoclicker set interval 1000"
            (box :orientation "horizontal" :halign "fill" :space-evenly false
              (label :text ac_iv_1000 :class "ac-row-mark")
              (label :text "1000 ms" :class "ac-row-name" :hexpand true :halign "start"))))
        (label :text "Timer button" :class "ac-section-title" :halign "start")
        (box :orientation "horizontal" :halign "fill" :space-evenly false
          (eventbox :class "ac-row" :timeout "1s" :cursor "pointer" :onclick "autoclicker set button left"
            (box :orientation "horizontal" :halign "fill" :space-evenly false
              (label :text ac_btn_left :class "ac-row-mark")
              (label :text "left" :class "ac-row-name" :hexpand true :halign "start")))
          (eventbox :class "ac-row" :timeout "1s" :cursor "pointer" :onclick "autoclicker set button middle"
            (box :orientation "horizontal" :halign "fill" :space-evenly false
              (label :text ac_btn_middle :class "ac-row-mark")
              (label :text "middle" :class "ac-row-name" :hexpand true :halign "start")))
          (eventbox :class "ac-row" :timeout "1s" :cursor "pointer" :onclick "autoclicker set button right"
            (box :orientation "horizontal" :halign "fill" :space-evenly false
              (label :text ac_btn_right :class "ac-row-mark")
              (label :text "right" :class "ac-row-name" :hexpand true :halign "start")))))
      (box :class "ac-section"
           :orientation "vertical"
           :halign "fill"
           :space-evenly false
        (label :text "Scroll target window" :class "ac-section-title" :halign "start")
        (eventbox :class "ac-row" :timeout "1s" :cursor "pointer" :onclick "autoclicker-target any"
          (label :text "Any window" :class "ac-row-name" :halign "start"))
        (eventbox :class "ac-row" :timeout "1s" :cursor "pointer" :onclick "autoclicker-target focused"
          (label :text "Focused window" :class "ac-row-name" :halign "start"))
        (eventbox :class "ac-row" :timeout "1s" :cursor "pointer" :onclick "autoclicker-target pick"
          (label :text "Pick with mouse..." :class "ac-row-name" :halign "start"))
        (eventbox :class "ac-row" :timeout "1s" :cursor "pointer" :onclick "autoclicker-target clear"
          (label :text "Clear" :class "ac-row-name" :halign "start"))
        (label :text ac_details :class "ac-details" :halign "start"))
      (label :text "left-click bar icon = on/off, middle = left/right, right = this menu"
             :class "ac-hint"
             :halign "start"))))
