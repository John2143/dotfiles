# NAS configuration — headless NixOS file server.
#
# Services: ZFS (auto-scrub, sanoid snapshots), Samba (cross-platform),
#           Immich (native NixOS), Avahi/mDNS, Tailscale, SSH.
#
# === ZFS POOL SETUP (one-time, after first boot) ===
#
# 1. Identify drives by serial:
#      ls -l /dev/disk/by-id/ | grep -v part
#
# 2. Create tank pool (RAIDZ1 on 4x 8TB HDDs):
#      sudo zpool create -o ashift=12 \
#        -O atime=off -O compression=lz4 -O xattr=sa -O acltype=posixacl \
#        -O mountpoint=none \
#        tank raidz1 \
#          /dev/disk/by-id/ata-ST8000..._1 \
#          /dev/disk/by-id/ata-ST8000..._2 \
#          /dev/disk/by-id/ata-ST8000..._3 \
#          /dev/disk/by-id/ata-ST8000..._4
#
# 3. Add mirrored special vdev (100GB SSD partitions):
#      sudo zpool add tank special mirror \
#        /dev/disk/by-id/wwn-0x5e83a97923abf0ec-part1 \
#        /dev/disk/by-id/wwn-0x5001b448be24504b-part4
#      sudo zfs set special_small_blocks=32K tank
#
# 4. Add L2ARC read cache (200GB SSD partition on boot SSD):
#      sudo zpool add tank cache /dev/disk/by-id/wwn-0x5001b448be24504b-part5
#
# 5. Create datasets:
#      sudo zfs create -o mountpoint=/tank/share    tank/share
#      sudo zfs create -o mountpoint=/tank/media    tank/media
#      sudo zfs create -o mountpoint=/tank/backups  tank/backups
#      sudo zfs create -o mountpoint=/tank/immich   tank/immich
#      sudo zfs create -o mountpoint=/tank/scratch  tank/scratch
#      sudo zfs create -o mountpoint=/tank/private  tank/private
#      sudo zfs create -o mountpoint=/tank/atticd   tank/atticd
#    Attic Nix cache — chunk-level dedup binary cache shared across all
#    machines. Store paths land on the raidz1 HDDs with lz4 compression:
#      sudo zfs create -o mountpoint=/tank/atticd \
#        -o recordsize=1M -o compression=lz4 -o atime=off tank/atticd
#      sudo chown atticd:atticd /tank/atticd
#
#    Minecraft — pinned entirely to the SSD special mirror for fast chunk
#    reads and mirrored integrity. recordsize=special_small_blocks=128K
#    means every block lands on the SSD, not the raidz1 HDDs.
#      sudo zfs create \
#        -o mountpoint=/tank/minecraft \
#        -o recordsize=128K \
#        -o special_small_blocks=128K \
#        -o compression=lz4 \
#        -o atime=off \
#        tank/minecraft
#      sudo chown john:john /tank/minecraft
#    Immich thumbnails — dedicated child dataset pinned to the SSD special
#    vdev for fast scrolling. recordsize=special_small_blocks=1M means every
#    block written under thumbs/ lands on the SSD mirror, not the raidz1
#    HDDs. Originals under tank/immich stay on HDD.
#      sudo systemctl stop immich-server immich-machine-learning
#      sudo mv /tank/immich/thumbs /tank/immich/thumbs.old   # if it exists
#      sudo zfs create \
#        -o mountpoint=/tank/immich/thumbs \
#        -o recordsize=1M \
#        -o special_small_blocks=1M \
#        -o compression=lz4 \
#        -o atime=off \
#        tank/immich/thumbs
#      sudo chown immich:immich /tank/immich/thumbs
#      sudo chmod 750 /tank/immich/thumbs
#      sudo rsync -aHAX /tank/immich/thumbs.old/ /tank/immich/thumbs/   # if moved
#      sudo systemctl start immich-server immich-machine-learning
#
# 7. Set ownership:
#      sudo chown john:john /tank/share /tank/media /tank/scratch /tank/private
#      sudo chown immich:immich /tank/immich
#      # /tank/backups must be root-owned for OpenSSH ChrootDirectory.
#      # Per-host subdirs are owned by the backup user:
#      sudo chown root:root /tank/backups && sudo chmod 755 /tank/backups
#      for h in arch office closet secu big; do
#        sudo zfs create tank/backups/$h   # or just: sudo mkdir /tank/backups/$h
#        sudo chown backup:backup /tank/backups/$h
#      done
#
# 8. Set Samba password:
#      sudo smbpasswd -a john
#
#
# 9. Longhorn replica storage.
#    Disk 1: /var/lib/longhorn — ext4 on sda6 (disko-managed, label "longhorn").
#      Holds primary Longhorn replicas. Recreated by disko on rebuild.
#    Disk 2: /var/lib/longhorn-2 — directory on root partition (sda2, ~1TiB).
#      Created by systemd-tmpfiles. Re-added to Longhorn node CRD post-rebuild.
#      UUID for longhorn-disk.cfg if recreating from scratch:
#        diskUUID: 719fbb40-d0b3-498c-a8e4-77b23a402481
#        diskName: nas-root-longhorn
#
# 10. Rebuild:
#      sudo nixos-rebuild switch --flake /home/john/dotfiles#nas
#
#
{
  config,
  lib,
  pkgs,
  pkgs-stable,
  inputs,
  compName,
  sshKeys,
  ...
}: {
  # fileSystems and swapDevices are generated by disko (see modules/disko_nas.nix).
  # Boot SSD disaster recovery steps are documented in the disko_nas.nix header.
  nixpkgs.overlays = [
    (final: prev: {
      vips_8_17 = prev.vips_8_17.overrideAttrs (old: {
        buildInputs =
          old.buildInputs
          ++ [
            final.libraw
            final.libultrahdr
          ];
      });
    })
  ];

  imports = [
    ./nas-hardware-configuration.nix
    ./modules/user-john.nix
    ./modules/disko_nas.nix
    ./modules/nut-ups.nix
    ./modules/nas-disk-health.nix
  ];
  fileSystems."/".neededForBoot = lib.mkForce true;
  home-manager.users."john" = import ./home-cli.nix;
  services.getty.autologinUser = "john";

  boot.loader = {
    systemd-boot.enable = true;
    efi.canTouchEfiVariables = true;
  };
  boot.kernel.sysctl = {
    "kernel.softlockup_panic" = "1";
    "kernel.panic_on_rcu_stall" = "1";
  };
  # Panic dumps in reserved RAM: efivarfs here is 128K with ~98K free, too small
  # for a 112-180K dump.
  custom.crashCapture.enable = true;
  custom.crashCapture.notify = false; # no ntfy-topic-url secret on this host
  custom.crashCapture.ramoops.enable = true;
  # Keeps this box's pre-existing 30s runtime watchdog (module default is 60s).
  custom.crashCapture.watchdogSec = "30s";
  boot.kernelParams = [
    # zswap disabled (was: enabled=1, zstd, zsmalloc, 30% pool). Compressed
    # swap interacted with the memory-path crashes on this box (swap_cgroup /
    # page-alloc NULL derefs in pstore captures); the 16 GiB dm-crypt swap
    # partition remains as the only swap device.
    #
    # ARC capped at 4 GiB (was 6). With systemReserved=5Gi the host's whole
    # guaranteed share is 5119 MiB, so a 6 GiB ARC exceeded it on its own and
    # forced swap every night: measured pods 4837 + system.slice 4540 + kernel
    # 1579 + ARC 4096 leaves ~320-580 MiB spare during the 03:00 backup, while
    # 5120 was still ~700 MiB over. A kernel param, so it applies at boot.
    "zfs.zfs_arc_max=4294967296"
  ];
  boot.kernelModules = [
    "target_core_mod"
    "iscsi_target_mod"
    # Fan/voltage monitoring (IT8728F on Z77X-UD3H) — lets us read fan RPMs.
    "it87"
  ];

  virtualisation.podman = {
    enable = true;
    dockerCompat = true;
  };

  # ==================
  # === Minecraft  ===
  # ==================

  # instead:
  # nix flake at /tank/minecraft/AoC/flake.nix: nix flake run
  #virtualisation.oci-containers = {
  #backend = "podman";
  #containers.minecraft = {
  #image = "docker.io/itzg/minecraft-server:latest";
  #ports = [ "25565:25565" ];
  #environment = {
  #EULA = "TRUE";
  #TYPE = "NEOFORGE";
  #MEMORY = "6G";
  #};
  #volumes = [
  #"/tank/minecraft:/data"
  #];
  #};
  #};

  # ================
  # === Network  ===
  # ================

  networking.hostName = compName;
  networking.networkmanager.enable = true;

  # mDNS on the LAN link only. Left to itself avahi joins every interface,
  # including the ephemeral veth pair of each k3s pod; every pod create or
  # delete makes it rescan ~25 interfaces and re-probe the host name, which is
  # how the box renamed itself to nas-5.local on 2026-11-19. bond0 is the only
  # LAN link (the shared deny list already covers tailscale0 and the k3s
  # bridges, but it cannot name the transient veth* links).
  services.avahi.settings.server.allow-interfaces = ["bond0"];

  # ZFS requires a stable hostId — generate with: head -c 8 /etc/machine-id
  networking.hostId = "115e93a1";

  # All three NICs in one active-backup bond so any port can be cabled.
  # 802.3ad is impossible here: enp1s0f1 is on the core switch while enp7s0
  # is on the router, and a 10G+1G LAG would strand half the flows.
  # cloned-mac-address pins the bond to the 10G NIC's MAC so the router's
  # DHCP lease for 192.168.5.175 (client-id 1:e8:4d:d0:c1:54:20) keeps
  # matching; fail_over_mac=none keeps that MAC across a failover so peers'
  # ARP entries survive.
  networking.networkmanager.ensureProfiles.profiles = {
    bond0 = {
      connection = {
        id = "bond0";
        uuid = "26e3a615-bb20-431f-80d0-da1d8584a737";
        type = "bond";
        interface-name = "bond0";
        autoconnect = "true";
      };
      # NM 1.58 keyfiles take bond options as individual keys, not an
      # `options=` string (that key is rejected as "invalid bond option").
      bond = {
        mode = "active-backup";
        miimon = "100";
        primary = "enp1s0f1";
        fail_over_mac = "none";
      };
      ethernet.cloned-mac-address = "E8:4D:D0:C1:54:20";
      ipv4 = {
        method = "auto";
        route-metric = "50";
      };
      ipv6 = {
        method = "auto";
        addr-gen-mode = "default";
        route-metric = "50";
        address1 = "fd00:1::175/64";
      };
    };
    bond0-port-enp1s0f0 = {
      connection = {
        id = "bond0-port-enp1s0f0";
        uuid = "25d43c9c-d407-4444-bb66-4dde62df4b91";
        type = "ethernet";
        interface-name = "enp1s0f0";
        controller = "bond0";
        port-type = "bond";
      };
      ethernet.cloned-mac-address = "E8:4D:D0:C1:54:20";
      ipv4.method = "disabled";
      ipv6.method = "disabled";
    };
    bond0-port-enp1s0f1 = {
      connection = {
        id = "bond0-port-enp1s0f1";
        uuid = "893d38e9-14a4-4af6-b6d2-fd7482dc4cf3";
        type = "ethernet";
        interface-name = "enp1s0f1";
        controller = "bond0";
        port-type = "bond";
      };
      ethernet.cloned-mac-address = "E8:4D:D0:C1:54:20";
      ipv4.method = "disabled";
      ipv6.method = "disabled";
    };
    bond0-port-enp7s0 = {
      connection = {
        id = "bond0-port-enp7s0";
        uuid = "e351ac6d-671c-44ce-b6e6-f0313942f638";
        type = "ethernet";
        interface-name = "enp7s0";
        controller = "bond0";
        port-type = "bond";
      };
      ethernet.cloned-mac-address = "E8:4D:D0:C1:54:20";
      ipv4.method = "disabled";
      ipv6.method = "disabled";
    };
  };
  # NetworkManager-ensure-profiles runs *after* NetworkManager.service, so at
  # boot NM sees enp7s0 with no profile yet, creates its "Wired connection N"
  # auto-default (DHCP v4+v6, autoconnect) and activates it. NM never moves an
  # active device to the bond port profile that appears a moment later, so
  # enp7s0 ran standalone with the same MAC and 192.168.5.175 as bond0 plus a
  # second default route, and its DHCPv6 lease collided with the router.
  networking.networkmanager.settings.main.no-auto-default = "enp1s0f0,enp1s0f1,enp7s0";

  # Guarded so deploying this cannot disturb a running system: bond0 is only
  # activated when it is not already up, and each port is only touched when its
  # device is not already on the matching profile. At boot it is what makes the
  # declarative bond (not an auto-default) win the link-up race on enp7s0.
  systemd.services.nas-bond-ensure = {
    description = "Activate bond0 and its ports from the declarative profiles";
    wants = ["NetworkManager-ensure-profiles.service"];
    after = ["NetworkManager.service" "NetworkManager-ensure-profiles.service"];
    before = ["network-online.target"];
    wantedBy = ["network-online.target"];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      NMCLI=${pkgs.networkmanager}/bin/nmcli
      GREP=${pkgs.gnugrep}/bin/grep
      for _ in 1 2 3 4 5; do
        if $NMCLI -t -f NAME connection show --active | $GREP -qx bond0; then
          break
        fi
        $NMCLI connection up bond0 || true
        sleep 5
      done
      for p in enp1s0f1 enp7s0; do
        if $NMCLI -t -f DEVICE,CONNECTION device status | $GREP -qx "$p:bond0-port-$p"; then
          continue
        fi
        $NMCLI connection up "bond0-port-$p" || true
      done
      $NMCLI -t -f NAME connection show --active | $GREP -qx bond0
    '';
  };

  # systemd 262's 99-default.link sets MACAddressPolicy=persistent for every
  # interface, virtual ones included. On bond0 that re-randomizes the MAC after
  # NetworkManager applies ethernet.cloned-mac-address, which moved the DHCP
  # lease off 192.168.5.175 to .66 and left the k3s node NotReady on its
  # advertised address. Sorts after 99-default.link so this wins.
  systemd.network.links."99-zz-bond0" = {
    matchConfig.OriginalName = "bond0";
    linkConfig = {
      MACAddressPolicy = "none";
      MACAddress = "E8:4D:D0:C1:54:20";
    };
  };

  time.timeZone = "America/New_York";
  i18n.defaultLocale = "en_US.UTF-8";
  console = {
    font = "Lat2-Terminus16";
    keyMap = "us";
  };

  environment.systemPackages = with pkgs; [
    git
    fish
    curl
    smartmontools # smartctl — inspect SMART on SATA/SCSI disks
    restic
    # Interactive use of the offsite jobs' tools (drills, `rclone lsl`) as root.
    # The units themselves set `path`; systemPackages is not on a unit's PATH.
    rclone
    jq
    kubectl
  ];

  programs.gnupg.agent = {
    enable = true;
    enableSSHSupport = true;
  };

  programs.fish.enable = true;

  # ================
  # === ZFS      ===
  # ================

  boot.zfs.forceImportRoot = false;

  services.zfs.autoScrub = {
    enable = true;
    interval = "monthly";
  };
  services.zfs.trim.enable = true;

  services.sanoid = {
    enable = true;
    datasets = {
      "tank/share" = {
        autosnap = true;
        hourly = 24;
        daily = 30;
        monthly = 6;
      };
      "tank/media" = {
        autosnap = true;
        daily = 7;
        monthly = 3;
      };
      "tank/immich" = {
        autosnap = true;
        hourly = 24;
        daily = 30;
        monthly = 6;
      };
      # tank/immich/thumbs lives on the SSD special vdev and is regenerable
      # from originals — don't waste SSD space snapshotting it.
      "tank/immich/thumbs" = {
        autosnap = false;
      };
      "tank/backups" = {
        autosnap = true;
        daily = 7;
        monthly = 3;
      };
      "tank/private" = {
        autosnap = true;
        daily = 30;
        monthly = 12;
        yearly = 1;
      };
      # Vault directories that stay on-site (never sent offsite). Same policy
      # as tank/private: the pool snapshots are its only history.
      # One-time (2026-11-19): a second gocryptfs root sharing the vault's master
      # key, so ciphertext can move between roots. Never `gocryptfs -init` here.
      #   sudo zfs create -o mountpoint=/tank/private-local -o compression=lz4 \
      #     -o recordsize=128K -o atime=off tank/private-local
      #   sudo mkdir /tank/private-local/john
      #   sudo cp /tank/private/john/gocryptfs.{conf,diriv} /tank/private-local/john/
      #   sudo chown -R john:users /tank/private-local/john
      "tank/private-local" = {
        autosnap = true;
        daily = 30;
        monthly = 12;
        yearly = 1;
      };
      "tank/minecraft" = {
        autosnap = true;
        hourly = 0;
        daily = 0;
        monthly = 0;
      };
      # k8s Longhorn backup target. Long retention because this is the
      # disaster-recovery layer for cluster PVCs.
      "tank/longhorn-backups" = {
        autosnap = true;
        daily = 30;
        monthly = 12;
      };
      # SeaweedFS chunk store (photos, frigate-genai). No app-level redundancy;
      # snapshots are the only history — 3 files already have permanent errors
      # from a prior crash. No hourly tier on a 778G busy dataset; daily covers it.
      "tank/seaweedfs-data" = {
        autosnap = true;
        daily = 14;
        hourly = 0;
        monthly = 6;
      };
    };
  };

  # k3s server — join existing cluster via mDNS (bootstrap without tailscale dependency).
  # NAS runs k3s on ZFS — keep ZFS mounted until k3s drains Longhorn volumes.
  custom.k3sStorageAfter = ["zfs-mount.service"];
  # Subnet routes come from k3s-server.nix; nas also offers itself as an exit node.
  services.tailscale.extraSetFlags = ["--advertise-exit-node"];

  # NAS reaches the cluster over bond0 (10G x2 + 1G, active-backup) at
  # 192.168.5.175; --node-ip stays pinned to that address and fd00:1::175.
  custom.k3sNet = {
    ipv4 = "192.168.5.175";
    ipv6 = "fd00:1::175";
    # Reserve 2 CPU + 5 GiB RAM for OS functions (ZFS ARC, Samba, Immich, NFS
    # run natively on NAS; k3s must not starve them — 2026-07-31 OOM panic).
    # 5 GiB is affordable because the database replicas moved off nas: kube
    # requests are 9772Mi against a 10752Mi allocatable, ~1 GiB of slack, and
    # the 6 GiB ARC cap now has room to fill past its old ~2.9 GiB ceiling.
    systemReserved = "cpu=2,memory=5Gi";
    # Registration-time only: k3s applies --node-label when the node first joins.
    nodeLabels = ["node.longhorn.io/create-default-disk=true"];
  };

  # ================
  # === NFS      ===
  # ================
  #
  # NFSv4 export used SOLELY as a Longhorn backup target for the k3s cluster.
  # No live PVCs sit on this — Longhorn replicates volume data on cluster
  # NVMe (closet + arch) and pushes incremental backups here on a schedule.
  # If this NFS server is unreachable, only new backup uploads pause; live
  # cluster workloads are unaffected.
  #
  # One-time on the NAS before the first rebuild that flips this on:
  #   sudo zfs create -o mountpoint=/tank/longhorn-backups -o recordsize=1M \
  #     -o compression=lz4 -o atime=off tank/longhorn-backups
  #   sudo chown nobody:nogroup /tank/longhorn-backups
  #   sudo chmod 0777 /tank/longhorn-backups
  #
  # The export is scoped to the Tailscale CGNAT range, matching the Samba
  # `hosts allow` line below. Single port (2049) — NFSv4 doesn't need
  # rpcbind/mountd/lockd.
  services.nfs.server = {
    enable = true;
    exports = ''
      /tank/longhorn-backups 100.64.0.0/10(rw,sync,no_subtree_check,no_root_squash,fsid=0) 192.168.5.0/24(rw,sync,no_subtree_check,no_root_squash,fsid=0) 10.42.0.0/16(rw,sync,no_subtree_check,no_root_squash,fsid=0)
      # ── Proxmox Backup Server datastore ──────────────────────
      # One-time: sudo zfs create -o mountpoint=/tank/backups/pbs -o recordsize=1M \
      #             -o compression=lz4 -o atime=off tank/backups/pbs
      /tank/backups/pbs       100.64.0.0/10(rw,sync,no_subtree_check,no_root_squash,fsid=2) 192.168.5.0/24(rw,sync,no_subtree_check,no_root_squash,fsid=2)
      # ── Observability archive ──────────────────────────────────
      # One-time: sudo zfs create -o mountpoint=/tank/logs -o recordsize=1M \
      #             -o compression=lz4 -o atime=off tank/logs
      #           sudo chown nobody:nogroup /tank/logs
      /tank/logs               100.64.0.0/10(rw,async,no_subtree_check,no_root_squash,fsid=3) 192.168.5.0/24(rw,async,no_subtree_check,no_root_squash,fsid=3)
      /tank/frigate           100.64.0.0/10(rw,sync,no_subtree_check,no_root_squash,all_squash,anonuid=1000,anongid=1000,fsid=1) 192.168.5.0/24(rw,sync,no_subtree_check,no_root_squash,all_squash,anonuid=1000,anongid=1000,fsid=1) 10.42.0.0/16(rw,sync,no_subtree_check,no_root_squash,all_squash,anonuid=1000,anongid=1000,fsid=1)
    '';
  };

  # ================
  # === Samba    ===
  # ================

  services.samba = {
    enable = true;
    openFirewall = true;
    settings = {
      global = {
        "server string" = "nas";
        "netbios name" = "nas";
        "workgroup" = "WORKGROUP";
        "server role" = "standalone server";
        # Include Tailscale CGNAT so phones / laptops on the tailnet can reach SMB.
        "hosts allow" = "192.168. 10.10. 100.64.0.0/10 127.0.0.1 localhost";
        "hosts deny" = "0.0.0.0/0";
        # macOS compatibility (Finder metadata, resource forks)
        "vfs objects" = "catia fruit streams_xattr";
        "fruit:metadata" = "stream";
        "fruit:model" = "MacSamba";
        "fruit:posix_rename" = "yes";
        "fruit:veto_appledouble" = "no";
        "fruit:nfs_aces" = "no";
        "fruit:wipe_intentionally_left_blank_rfork" = "yes";
        "fruit:delete_empty_adfiles" = "yes";
        "server min protocol" = "SMB2";
        "ea support" = "yes";
        "server signing" = "auto";
        "server smb encrypt" = "auto";
        "map to guest" = "Bad User";
        "host msdfs" = "no";
      };
      share = {
        path = "/tank/share";
        browseable = "yes";
        "read only" = "yes";
        "guest ok" = "yes";
        "write list" = "john ewan brown amandastry";
        "create mask" = "0664";
        "directory mask" = "2775";
      };
      media = {
        path = "/tank/media";
        browseable = "yes";
        "read only" = "yes";
        "valid users" = "john ewan brown amandastry";
      };
      scratch = {
        path = "/tank/scratch";
        browseable = "yes";
        "read only" = "no";
        "valid users" = "john ewan brown amandastry";
        "create mask" = "0664";
        "directory mask" = "2775";
      };
      private = {
        path = "/tank/private/%U";
        browseable = "yes";
        "read only" = "no";
        "valid users" = "john amandastry";
        "create mask" = "0600";
        "directory mask" = "0700";
      };
      # Second gocryptfs root (same master key) for vault directories that
      # are excluded from offsite-private. Only john has a root here.
      private-local = {
        path = "/tank/private-local/%U";
        browseable = "yes";
        "read only" = "no";
        "valid users" = "john";
        "create mask" = "0600";
        "directory mask" = "0700";
      };
    };
  };

  services.samba-wsdd = {
    enable = true;
    openFirewall = true;
  };
  systemd.services.samba-smbd.environment = {
    NSS_WRAPPER_P11_KIT = "0";
  };

  # ================
  # === Immich   ===
  # ================

  services.immich = {
    enable = true;
    host = "0.0.0.0";
    port = 2283;
    openFirewall = true;
    mediaLocation = "/tank/immich";
    machine-learning.enable = true;
    database.enable = true;
    redis.enable = true;

    # Setting `settings` makes NixOS write /run/immich/config.json and export
    # IMMICH_CONFIG_FILE. Immich then REFUSES every admin-UI config write
    # ("Cannot update configuration while IMMICH_CONFIG_FILE is in use"), so
    # everything here is authoritative and the UI is read-only for config.
    settings = {
      # Public serving of /share/* is handled by the k8s `immich-public-proxy`
      # workload fronting images.2143.me. This setting only controls the URL
      # Immich embeds in generated share links (and a few other UI-copied URLs).
      server.externalDomain = "https://images.2143.me";

      # Pocket ID. clientId is a public OIDC identifier (headscale's is likewise
      # committed). The client secret is read from the agenix file below and
      # never enters the Nix store or this repo.
      oauth = {
        enabled = true;
        issuerUrl = "https://au.2143.me";
        clientId = "fc5eb5a2-013a-4c88-978f-fe2402839411";
        clientSecret._secret = config.age.secrets.immich-oidc-client-secret.path;
        scope = "openid email profile";
        signingAlgorithm = "RS256";
        tokenEndpointAuthMethod = "client_secret_post";
        autoRegister = false;
        autoLaunch = false;
        buttonText = "Sign in with Pocket ID";
      };

      # SSO-only. john and leighanne are linked; amanda links on her first
      # Pocket ID sign-in. `login()` throws before it compares the password,
      # so there is no admin bypass -- reverting this line and rebuilding is
      # the only way back in if Pocket ID becomes unreachable.
      passwordLogin.enabled = false;
    };
  };

  # ================
  # === Services ===
  # ================

  services.openssh.enable = true;
  users.users."john".openssh.authorizedKeys.keys = sshKeys;

  users.groups.backup = {};
  users.users.backup = {
    isNormalUser = true;
    group = "backup";
    home = "/tank/backups";
    createHome = false;
    shell = pkgs.shadow + "/bin/nologin";
    openssh.authorizedKeys.keys = [
      # Dedicated backup keypair — NOT john's personal keys.
      # Generate: ssh-keygen -t ed25519 -f /tmp/backup-key -N "" -C "backup@nas"
      # Paste the public key here, encrypt the private key with agenix.
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHc7Lm/K9+ayv0s8Emk8z89Cgtzm5jexAUfdcjoJAinw backup@nas"
    ];
  };

  services.openssh.extraConfig = ''
    Match User backup
      ForceCommand internal-sftp
      ChrootDirectory /tank/backups
      AllowTcpForwarding no
      X11Forwarding no
      PermitTunnel no
  '';

  # ── NUT UPS monitoring ────────────────────────────────────────────
  # power.ups handles usbhid-ups auto-detect, webhooks, and k3s drain.
  # See modules/nut-ups.nix for the shared config.
  custom.nut-ups = {
    enable = true;
    haWebhooks = true;
    k3sDrain = true;
    extraShutdownCommands = ["systemctl stop atticd"];
  };

  # ====================
  # === Attic Cache ===
  # ====================

  # ZFS datasets (one-time):
  #   Data:    sudo zfs create -o mountpoint=/tank/atticd -o recordsize=1M -o compression=lz4 -o atime=off tank/atticd
  #   Cache:   sudo zfs create -o mountpoint=/tank/atticd/storage -o recordsize=1M -o compression=lz4 -o atime=off tank/atticd/storage
  #   DB:      legacy — the DB moved to /var/lib/atticd (root SSD) on 2026-11-19
  #            because tank's pool-wide txg coupled every commit to bulk HDD I/O.
  #            tank/atticd/db still holds the pre-move copy; destroy it when done.
  #   Owner:   sudo chown atticd:atticd /tank/atticd /tank/atticd/storage

  # Declarative cache bootstrap — creates + configures the cache on first boot.
  # Token generation remains imperative: atticd-atticadm make-token
  systemd.services.attic-cache-bootstrap = {
    description = "Ensure Attic cache 2143nix exists and is configured";
    after = ["atticd.service"];
    requires = ["atticd.service"];
    wantedBy = ["multi-user.target"];
    startLimitIntervalSec = 0;
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      Restart = "on-failure";
      RestartSec = "5";
    };
    script = ''
      TOKEN=$(</run/agenix/attic-admin-token)
      ${pkgs.attic-client}/bin/attic login nas http://localhost:8280 "$TOKEN"
      if ! ${pkgs.attic-client}/bin/attic cache info 2143nix >/dev/null 2>&1; then
        ${pkgs.attic-client}/bin/attic cache create 2143nix
      fi
      ${pkgs.attic-client}/bin/attic cache configure 2143nix --priority 25 --retention-period "90 days"
    '';
  };
  services.atticd = {
    enable = true;
    environmentFile = config.age.secrets.attic-jwt-secret.path;
    settings = {
      listen = "[::]:8280";
      allowed-hosts = ["nas.ts.2143.me" "nas.ts.2143.me:8280" "nas" "nas:8280" "nas.local" "nas.local:8280" "localhost" "localhost:8280" "100.64.0.14" "100.64.0.14:8280"];
      api-endpoint = "http://nas:8280/";
      # The DB lives on the root SSD, NOT on tank. On tank every SQLite commit
      # waits for a pool-wide txg that also carries Longhorn, seaweedfs and
      # immich writes (raidz1 with two SMR drives), so under any bulk I/O the
      # DB blocks, the connection pool starves and every narinfo 500s — 2026-11-19
      # produced 14 failures in the first five minutes of a post-reboot Longhorn
      # rebuild, each a 30 s pool timeout that nix escalates to a build failure.
      # 103 MB of metadata on an SSD also sits outside the pool's corruption.
      database.url = "sqlite:///var/lib/atticd/server.db?mode=rwc";

      # atticd never runs ANALYZE, so a restored or rebuilt server.db has no
      # sqlite_stat1, SQLite treats `state = ?` as selective as
      # `chunk_hash = ?`, and every chunk insert scans all valid chunks: one
      # worker pins a core and uploads collapse (measured 2026-11-18 on
      # 79k valid chunks / 64 MB: 89% CPU on the sqlx thread, 105k read
      # syscalls/s, client 86% receive-window limited, 0.5 MB/s).
      # One ANALYZE fixes it — the plan flips to idx-chunk-chunk-hash and an
      # 8 MB push went 15.19 s -> 0.59 s (0.5 -> 13.6 MB/s), no restart.
      # Re-run after restoring the .preanalyze backup and periodically as
      # chunks accumulate: the statistics go stale, the plan does not.
      # Upstream zhaofengli/attic#377, unfixed in main as of 2026-11-18.
      #
      #   python3 -c 'import sqlite3;c=sqlite3.connect("/var/lib/atticd/server.db");c.execute("ANALYZE");c.commit()'
      #
      # Confirm with: EXPLAIN QUERY PLAN SELECT id FROM chunk WHERE
      # chunk_hash=? AND state=? LIMIT 1 — good says
      # "USING INDEX idx-chunk-chunk-hash (chunk_hash=?)", bad says
      # idx-chunk-state-holders. Same class of gap, much smaller cost still
      # unindexed: nar(nar_hash) and object(nar_id) (the 12-hourly GC walks
      # the latter).

      # Periodic GC — atticd prunes NARs/chunks unreferenced by any cache.
      # Without this the DB and storage drift apart (DB rows pointing at
      # chunk files that no longer exist -> "Storage error: No such file").
      garbage-collection.interval = "12 hours";

      storage = {
        type = "local";
        path = "/tank/atticd/storage";
      };
    };
  };

  age.secrets.attic-jwt-secret = {
    file = ../secrets/attic-jwt-secret.age;
    mode = "0400";
    owner = "atticd";
    group = "atticd";
  };

  age.secrets.immich-oidc-client-secret = {
    file = ../secrets/immich-oidc-client-secret.age;
    mode = "0400";
    owner = "root";
    group = "root";
  };

  # ======================
  # === Offsite (B2)   ===
  # ======================
  # Append-only copies of the data that cannot be rebuilt, into three
  # COMPLIANCE-locked (30 d) B2 buckets with prefix-scoped lifecycle rules.
  # Runbook and restore procedures: argo docs/offsite-data.md.
  # Each env file defines the rclone remote `hz` (bucket-scoped app key plus
  # that bucket's SSE-C key) through RCLONE_CONFIG_HZ_* variables.
  age.secrets.rclone-immich-env = {
    file = ../secrets/rclone-immich.env.age;
    mode = "0400";
    owner = "root";
    group = "root";
  };
  age.secrets.rclone-private-env = {
    file = ../secrets/rclone-private.env.age;
    mode = "0400";
    owner = "root";
    group = "root";
  };
  age.secrets.rclone-volumes-env = {
    file = ../secrets/rclone-volumes.env.age;
    mode = "0400";
    owner = "root";
    group = "root";
  };
  # NTFY_TOPIC_URL for notify-failure@ below.
  age.secrets.ntfy-topic-url = {
    file = ../secrets/ntfy-topic-url.age;
    mode = "0400";
    owner = "root";
    group = "root";
  };

  # Daily logical dump. immich's Postgres lives on the root SSD, not the pool,
  # so this object is the only copy if that disk dies. Expires via `db/` rule.
  systemd.services.offsite-immich-db = {
    description = "Offsite: pg_dump immich to B2";
    restartIfChanged = false;
    onFailure = ["notify-failure@%n.service"];
    path = [pkgs.util-linux pkgs.rclone];
    environment = {
      RCLONE_STATS = "10m";
      RCLONE_STATS_LOG_LEVEL = "NOTICE";
      # Without HOME (and no getent on PATH) rclone logs three ERROR lines per run.
      HOME = "/root";
    };
    serviceConfig = {
      Type = "oneshot";
      EnvironmentFile = config.age.secrets.rclone-immich-env.path;
    };
    script = ''
      set -euo pipefail
      runuser -u postgres -- ${config.services.postgresql.package}/bin/pg_dump -Fc immich \
        | rclone rcat "hz:j2143-argo-immich/db/$(date -u +%Y%m%dT%H%M%SZ).dump"
    '';
  };
  systemd.timers.offsite-immich-db = {
    wantedBy = ["timers.target"];
    timerConfig = {
      OnCalendar = "*-*-* 05:30:00";
      Persistent = true;
    };
  };

  # Weekly originals. Plain `copy` (never sync): objects are written once and
  # never expire; thumbs/ and encoded-video/ are regenerable and excluded.
  systemd.services.offsite-immich-media = {
    description = "Offsite: copy immich originals to B2";
    restartIfChanged = false;
    onFailure = ["notify-failure@%n.service"];
    path = [pkgs.rclone];
    environment = {
      RCLONE_STATS = "10m";
      RCLONE_STATS_LOG_LEVEL = "NOTICE";
      HOME = "/root";
    };
    serviceConfig = {
      Type = "oneshot";
      EnvironmentFile = config.age.secrets.rclone-immich-env.path;
    };
    script = ''
      set -euo pipefail
      rclone copy /tank/immich hz:j2143-argo-immich/media \
        --exclude "thumbs/**" --exclude "encoded-video/**" \
        --transfers 8 --checkers 16 --s3-chunk-size 32M
    '';
  };
  systemd.timers.offsite-immich-media = {
    wantedBy = ["timers.target"];
    timerConfig = {
      OnCalendar = "Sun *-*-* 05:00:00";
      Persistent = true;
    };
  };

  # Weekly `zfs send` of tank/private (gocryptfs ciphertext). One full stream
  # per 13-week generation, then incrementals; the `zfs/` rule hides objects
  # at day 120, so a generation's base always outlives its chain. Only the
  # newest @offsite-* snapshot is kept: it is the next incremental's source.
  systemd.services.offsite-private = {
    description = "Offsite: zfs send tank/private to B2";
    restartIfChanged = false;
    # Hard hold. While this file exists the unit is skipped (ConditionPathExists,
    # not a failure) even when the timer fires: both timers are Persistent=true,
    # so a re-armed timer with no record of a past run fires IMMEDIATELY. Without
    # this, a reboot or a fleet-patch switch would start uploading whatever
    # tank/private holds at that moment.
    #   Hold:   sudo mkdir -p /var/lib/offsite && sudo touch /var/lib/offsite/hold
    #   Resume: sudo rm /var/lib/offsite/hold
    unitConfig.ConditionPathExists = "!/var/lib/offsite/hold";
    onFailure = ["notify-failure@%n.service"];
    path = [config.boot.zfs.package pkgs.rclone pkgs.gawk pkgs.gnugrep pkgs.findutils];
    environment = {
      RCLONE_STATS = "10m";
      RCLONE_STATS_LOG_LEVEL = "NOTICE";
      HOME = "/root";
    };
    serviceConfig = {
      Type = "oneshot";
      StateDirectory = "offsite";
      EnvironmentFile = config.age.secrets.rclone-private-env.path;
    };
    script = ''
      set -euo pipefail
      state=/var/lib/offsite
      week=$(date -u +%G-W%V)
      gen="gen-$(date -u +%G)-$(printf %02d $(( 10#$(date -u +%V) / 13 )))"
      last=$(cat "$state/private.last" 2>/dev/null || true)
      if [ "$last" = "$week" ]; then
        echo "offsite-private: $week already sent; nothing to do"
        exit 0
      fi
      snap="tank/private@offsite-$week"
      zfs list -H -o name -t snapshot "$snap" >/dev/null 2>&1 || zfs snapshot "$snap"
      if [ "$(cat "$state/private.gen" 2>/dev/null || true)" = "$gen" ] && [ -n "$last" ] \
         && zfs list -H -o name -t snapshot "tank/private@offsite-$last" >/dev/null 2>&1; then
        send=(-c -i "@offsite-$last" "$snap"); obj="zfs/$gen/$week.zfs"
      else
        send=(-c "$snap"); obj="zfs/$gen/$week-full.zfs"
      fi
      # rcat of an unknown-size stream is capped at 10,000 parts: size the
      # chunk from zfs's own estimate so a multi-TiB full cannot hit the cap.
      bytes=$(zfs send -nP "''${send[@]}" | awk '$1 == "size" {print $2}')
      chunk=$(( bytes / 9000 / 1048576 + 1 ))
      if [ "$chunk" -lt 32 ]; then chunk=32; fi
      echo "offsite-private: sending $obj (~$bytes bytes, chunk ''${chunk}M)"
      zfs send "''${send[@]}" | rclone rcat "hz:j2143-argo-private/$obj" --s3-chunk-size "''${chunk}M"
      printf %s "$week" > "$state/private.last"
      printf %s "$gen" > "$state/private.gen"
      # grep exits 1 when only $snap exists; that is the normal steady state.
      old=$(zfs list -H -o name -t snapshot tank/private | grep '^tank/private@offsite-' | grep -vxF "$snap" || true)
      for s in $old; do zfs destroy "$s"; done
    '';
  };
  systemd.timers.offsite-private = {
    wantedBy = ["timers.target"];
    timerConfig = {
      OnCalendar = "Sun *-*-* 04:00:00";
      Persistent = true;
    };
  };

  # Weekly mirror of the Longhorn backupstore for PVCs annotated
  # offsite.backup/enabled=true. Longhorn backups share deduplicated blocks,
  # so an append-only mirror under a fixed prefix would lose still-referenced
  # blocks to the `longhorn/` 60-day rule. Each 4-week generation is therefore
  # a complete, self-contained copy (blocks re-uploaded), and every backup in
  # a generation stays restorable for 60 days after that generation began.
  # The hashed volumes/<xx>/<yy>/<pvc> layout is kept so a restore copies the
  # directory straight back into a backupstore.
  systemd.services.offsite-volumes = {
    description = "Offsite: mirror tagged Longhorn backups to B2";
    restartIfChanged = false;
    onFailure = ["notify-failure@%n.service"];
    after = ["k3s.service"];
    path = [pkgs.kubectl pkgs.jq pkgs.rclone pkgs.findutils];
    environment = {
      KUBECONFIG = "/etc/rancher/k3s/k3s.yaml";
      RCLONE_STATS = "10m";
      RCLONE_STATS_LOG_LEVEL = "NOTICE";
      HOME = "/root";
    };
    serviceConfig = {
      Type = "oneshot";
      EnvironmentFile = config.age.secrets.rclone-volumes-env.path;
    };
    script = ''
      set -euo pipefail
      store=/tank/longhorn-backups/backupstore/volumes
      gen="gen-$(date -u +%G)-$(printf %02d $(( 10#$(date -u +%V) / 4 )))"
      # namespace/name pairs: two namespaces each have a `seafile-data` and an
      # `odoo-filestore`, so a bare name would match untagged PVCs too.
      selected=$(kubectl get pvc -A -o json | jq -r '.items[]
        | select(.metadata.annotations["offsite.backup/enabled"] == "true")
        | .metadata.namespace + "/" + .metadata.name')
      # Empty-selection guards: without them a filter typo would not fail,
      # it would silently mirror nothing (or, if loosened, everything).
      if [ -z "$selected" ]; then echo "offsite-volumes: no PVCs tagged; nothing to mirror"; exit 0; fi
      volumes=$(kubectl -n longhorn-system get volumes.longhorn.io -o json | jq -r --arg sel "$selected" '
        ($sel | split("\n")) as $s | .items[]
        | select((.status.kubernetesStatus.namespace + "/" + .status.kubernetesStatus.pvcName) as $k
                 | $s | any(. == $k))
        | .metadata.name')
      if [ -z "$volumes" ]; then echo "offsite-volumes: no volumes matched; nothing to mirror"; exit 0; fi
      want=$(printf '%s\n' "$selected" | wc -l); got=$(printf '%s\n' "$volumes" | wc -l)
      echo "offsite-volumes: $want tagged PVCs -> $got Longhorn volumes, generation $gen"
      rc=0
      if [ "$want" -ne "$got" ]; then echo "offsite-volumes: tagged PVC without a Longhorn volume"; rc=1; fi
      for v in $volumes; do
        d=$(find "$store" -mindepth 3 -maxdepth 3 -type d -name "$v" -print -quit)
        if [ -z "$d" ]; then echo "offsite-volumes: no backupstore directory for $v"; rc=1; continue; fi
        rclone copy "$d" "hz:j2143-argo-volumes/longhorn/$gen/volumes/''${d#"$store"/}" \
          --transfers 4 --checkers 8 --s3-chunk-size 32M
      done
      exit "$rc"
    '';
  };
  systemd.timers.offsite-volumes = {
    wantedBy = ["timers.target"];
    timerConfig = {
      OnCalendar = "Sun *-*-* 06:00:00";
      Persistent = true;
    };
  };

  # SeaweedFS keeps each collection in append-only volume files
  # (<collection>_<id>.dat plus a small .idx) on tank/seaweedfs-data, a
  # hostPath dataset, so those bytes are invisible to both the Longhorn mirror
  # and the database dumps. `imagehost-files` is the john2143.com upload set —
  # the largest customer-owned dataset in the estate, ~219 GiB in 46 volumes.
  # The copy reads the newest ZFS snapshot rather than the live directory:
  # SeaweedFS appends to these files, so a live copy can catch a torn tail,
  # while .zfs/snapshot/ is point-in-time and lets rclone skip unchanged
  # volumes by size and mtime on later runs.
  systemd.services.offsite-seaweedfs = {
    description = "Offsite: mirror SeaweedFS collections to B2";
    restartIfChanged = false;
    onFailure = ["notify-failure@%n.service"];
    path = [pkgs.rclone pkgs.coreutils pkgs.findutils];
    environment = {
      RCLONE_STATS = "10m";
      RCLONE_STATS_LOG_LEVEL = "NOTICE";
      HOME = "/root";
    };
    serviceConfig = {
      Type = "oneshot";
      EnvironmentFile = config.age.secrets.rclone-volumes-env.path;
    };
    script = ''
      set -euo pipefail
      store=/tank/seaweedfs-data
      collections="imagehost-files edge-tofu-state rots4-replays"
      snap=$(ls -1d "$store"/.zfs/snapshot/autosnap_*_daily 2>/dev/null | sort | tail -1 || true)
      if [ -z "$snap" ] || [ ! -d "$snap" ]; then
        echo "offsite-seaweedfs: no daily snapshot under $store/.zfs/snapshot"; exit 1
      fi
      echo "offsite-seaweedfs: copying from $snap"
      for c in $collections; do
        if [ -z "$(find "$snap" -maxdepth 1 -name "''${c}_*.dat" -print -quit)" ]; then
          echo "offsite-seaweedfs: no volume files for $c; skipping"; continue
        fi
        rclone copy "$snap" "hz:j2143-argo-volumes/seaweedfs/$c" \
          --include "''${c}_*.dat" --include "''${c}_*.idx" \
          --transfers 4 --checkers 8 --s3-chunk-size 32M
      done
    '';
  };
  systemd.timers.offsite-seaweedfs = {
    wantedBy = ["timers.target"];
    timerConfig = {
      OnCalendar = "Sun *-*-* 07:00:00";
      Persistent = true;
    };
  };

  # ntfy push for a failed unit (OnFailure=notify-failure@%n.service). Same
  # shape as modules/fleet-patching.nix, which this host does not import; the
  # root-owned secret is handed to the john-run unit as a credential.
  systemd.services."notify-failure@" = {
    description = "ntfy alert for failed unit %i";
    path = [pkgs.curl];
    scriptArgs = "%i";
    serviceConfig = {
      Type = "oneshot";
      User = "john";
      LoadCredential = ["ntfy-topic-url:${config.age.secrets.ntfy-topic-url.path}"];
    };
    script = ''
      set -a; . "$CREDENTIALS_DIRECTORY/ntfy-topic-url"; set +a
      # -o /dev/null: ntfy echoes the message JSON, topic name included, into the journal.
      curl -fsS -o /dev/null -m 20 -H "Title: $1 failed on nas" -H "Priority: high" -H "Tags: rotating_light" \
        -d "journalctl -u $1 -n 200 on nas" "$NTFY_TOPIC_URL"
    '';
  };

  # Persistent user for ZFS dataset ownership.
  # The nixpkgs module already defines atticd as a system user; these
  # declarations merge with the module's defaults.
  users.users.atticd = {
    isSystemUser = true;
    group = "atticd";
  };
  users.groups.atticd = {};

  # Disable DynamicUser + PrivateUsers so atticd can own ZFS datasets
  # that persist across reboots. ReadWritePaths covers the full
  # /tank/atticd tree (database + storage subdirectory).
  systemd.services.atticd.serviceConfig = {
    DynamicUser = lib.mkForce false;
    PrivateUsers = lib.mkForce false;
    ReadWritePaths = ["/tank/atticd"];
    # Guardrail: atticd once swapped the whole box out (7.2G swap) during
    # the Sep 2026 storage/DB divergence. Cap it so it OOMs itself rather
    # than taking the host down.
    MemoryHigh = "3G";
    MemoryMax = "6G";
    MemorySwapMax = "1G";
    TimeoutStopSec = "30s";
  };

  # One-time move of the DB off tank/atticd/db (2026-11-19). Runs as the
  # atticd user after systemd has created /var/lib/atticd, so the switch that
  # introduces database.url's new path performs the migration itself. The old
  # copy stays on tank as a fallback; destroy the dataset once this is past.
  systemd.services.atticd.preStart = ''
    if [ ! -e /var/lib/atticd/server.db ] && [ -e /tank/atticd/db/server.db ]; then
      echo "migrating attic DB to /var/lib/atticd"
      for f in server.db server.db-wal server.db-shm; do
        [ -e "/tank/atticd/db/$f" ] && cp -p "/tank/atticd/db/$f" "/var/lib/atticd/$f"
      done
    fi
  '';

  # atticd can wedge while staying `active` — SQLite pool starvation (Nov 16,
  # Nov 19) and ZFS directory hangs all look like this — so systemd never
  # restarts it and every request 500s, which nix turns into a failed build.
  # A wedged daemon still answers nothing at all, so probe a DB-backed
  # narinfo: anything that is not a real HTTP answer means restart.
  #
  # It also publishes atticd's blocked-thread count. A `du`/`find` over
  # /tank/atticd/storage wedges ZFS dentries (twice on 2026-11-19) and
  # every victim sits in path_openat: narinfo still answers in ~7 ms while NAR
  # bodies stall mid-stream, so no HTTP probe can see it. Do NOT restart on a
  # high count — a kernel-level dentry hang outlives the process and the old one
  # leaves zombie threads holding its DB handle (2026-11-19: restart produced a
  # defunct atticd and `database is locked` for the new one). Only a reboot clears it.
  systemd.services.atticd-watchdog = {
    description = "Restart atticd if narinfo stops answering";
    path = [pkgs.gawk];
    serviceConfig.Type = "oneshot";
    script = ''
      pid=$(systemctl show atticd -p MainPID --value)
      blocked=$(cat /proc/"$pid"/task/*/stat 2>/dev/null | awk '$3 == "D" {n++} END {print n+0}')
      [ -n "$blocked" ] || blocked=0
      out=$(mktemp /var/lib/node_exporter/textfile/.attic.XXXXXX)
      trap 'rm -f "$out"' EXIT
      echo "atticd_blocked_threads $blocked" > "$out"
      chmod 0644 "$out"
      mv "$out" /var/lib/node_exporter/textfile/attic.prom
      trap - EXIT

      systemctl is-active --quiet atticd || exit 0
      code=$(${lib.getExe pkgs.curl} -s -o /dev/null -m 15 -w '%{http_code}' \
        http://localhost:8280/2143nix/00000000000000000000000000000000.narinfo || true)
      case "$code" in
        2*|3*|4*) exit 0 ;;
      esac
      echo "atticd narinfo probe returned '$code' - restarting" >&2
      systemctl restart atticd
    '';
  };
  systemd.timers.atticd-watchdog = {
    wantedBy = ["timers.target"];
    timerConfig = {
      OnBootSec = "10min";
      OnUnitActiveSec = "5min";
    };
  };

  # Basic ZFS pool health for Prometheus. node_exporter's zfs collector reads
  # /proc/spl/kstat/zfs only, so it reports pool *state* but never the data-error
  # count, per-device error counters or fragmentation that zpool(8) carries.
  # Publish those through the textfile collector services.nixos-metrics already
  # points at /var/lib/node_exporter/textfile.
  systemd.services.zfs-metrics = {
    description = "Publish basic ZFS pool health to node_exporter";
    path = [config.boot.zfs.package pkgs.gawk pkgs.gnused pkgs.coreutils];
    serviceConfig = {
      Type = "oneshot";
      User = "root"; # zpool(8) needs /dev/zfs
    };
    script = ''
      set -eu
      out=$(mktemp /var/lib/node_exporter/textfile/.zfs.XXXXXX)
      trap 'rm -f "$out"' EXIT
      {
        for pool in $(zpool list -Hpo name); do
          # `zpool status -x` exits 0 whether or not the pool is healthy — the
          # signal is its `errors:` line: "No known data errors" vs "N data errors".
          errors=$(zpool status -x "$pool" | sed -n 's/^errors: \([0-9][0-9]*\) data errors.*/\1/p')
          echo "zfs_pool_data_errors{zpool=\"$pool\"} ''${errors:-0}"

          frag=$(zpool list -Hpo fragmentation "$pool")
          if [ -n "$frag" ] && [ "$frag" != "-" ]; then
            echo "zfs_pool_fragmentation_ratio{zpool=\"$pool\"} $(awk -v f="$frag" 'BEGIN { printf "%.2f", f / 100 }')"
          fi

          zpool status -px "$pool" | awk -v p="$pool" '$2 ~ /^(ONLINE|DEGRADED|FAULTED|OFFLINE|UNAVAIL|REMOVED|SUSPENDED)$/ && NF >= 5 {
            printf "zfs_pool_device_errors{zpool=\"%s\",vdev=\"%s\",type=\"read\"} %s\n", p, $1, $3
            printf "zfs_pool_device_errors{zpool=\"%s\",vdev=\"%s\",type=\"write\"} %s\n", p, $1, $4
            printf "zfs_pool_device_errors{zpool=\"%s\",vdev=\"%s\",type=\"cksum\"} %s\n", p, $1, $5
          }'
        done
      } > "$out"
      chmod 0644 "$out"
      mv "$out" /var/lib/node_exporter/textfile/zfs.prom
      trap - EXIT
    '';
  };

  systemd.timers.zfs-metrics = {
    description = "Refresh ZFS pool health metrics";
    wantedBy = ["timers.target"];
    timerConfig = {
      OnBootSec = "2min";
      OnUnitActiveSec = "5min";
    };
  };

  security.rtkit.enable = true;

  networking.firewall = {
    enable = true;
    allowedTCPPorts = [
      111 # rpcbind (NFS)
      2049 # nfsv4 (NFS) — Longhorn backup target
      2283 # immich (immich-server)
      25565 # minecraft (paperMC)
      5580 # matter-server (hostNetwork pod)
      179 # BGP (MetalLB speaker)
      8280 # attic nix cache — nas-configuration.nix:557
      10250 # kubelet (k3s agent)
      9100 # node_exporter (Prometheus metrics)

      20048 # rpc.mountd (NFS)
      4002 # NFS lockd/NLM (v3 file locks — PBS datastore needs flock)
    ];
    allowedTCPPortRanges = [
      {
        from = 30000;
        to = 32767;
      } # Kubernetes NodePort range
    ];
    allowedUDPPorts = [
      111 # rpcbind (NFS)
      20048 # rpc.mountd (NFS)
      4002 # NFS lockd/NLM (v3 file locks — PBS datastore needs flock)
      5540 # matter-server (hostNetwork pod)
      8472 # flannel VXLAN
    ];
  };

  # Pin the kernel NFS lockd/NLM service to a fixed port so the firewall can
  # allow NFSv3 file locks (needed by the PBS datastore's flock). Without a
  # fixed port, lockd picks a random high port that the firewall drops.
  boot.extraModprobeConfig = "options lockd nlm_tcpport=4002 nlm_udpport=4002";

  # Attic cache via loopback — no external cache dependency.
  nix.settings.substituters = lib.mkForce [
    "http://localhost:8280/2143nix"
  ];

  # Longhorn disks are managed declaratively:
  #   - /var/lib/longhorn on sda6 → disko (`disko_nas.nix`)
  #   - /var/lib/longhorn-2 on root → systemd-tmpfiles (`longhorn-host.nix`)
  # After a full rebuild, re-add the second disk to the Longhorn node CRD:
  #   kubectl patch nodes.longhorn.io -n longhorn-system nas --type=merge \
  #     -p '{"spec":{"disks":{"nas-root-longhorn":{"allowScheduling":true,"diskDriver":"","diskType":"filesystem","evictionRequested":false,"path":"/var/lib/longhorn-2","storageReserved":42949672960,"tags":[]}}}}'
  # Then delete the instance-manager pod on nas to pick up the change:
  #   kubectl delete pod -n longhorn-system -l longhorn.io/instance-manager -l longhorn.io/node=nas

  system.stateVersion = "26.05";
}
